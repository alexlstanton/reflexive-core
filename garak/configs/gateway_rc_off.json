{
  "rest": {
    "RestGenerator": {
      "name": "rc-off-passthrough",
      "uri": "http://127.0.0.1:1237/v1/chat/completions",
      "method": "post",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer lm-studio"
      },
      "req_template_json_object": {
        "model": "$MODEL",
        "messages": [
          {"role": "user", "content": "$INPUT"}
        ],
        "temperature": 0.7,
        "max_tokens": 2048
      },
      "response_json": true,
      "response_json_field": "$.choices[0].message.content",
      "request_timeout": 300,
      "ratelimit_codes": [429],
      "skip_codes": []
    }
  }
}
